NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The bare domain is canonical. Used for metadataBase, canonical links,
# sitemap, RSS/JSON feeds, and OG tags — every generated URL must match the
# host the site actually resolves at. www.equity.tw redirects to this at
# the Vercel domain level.
NEXT_PUBLIC_SITE_URL=https://equity.tw
